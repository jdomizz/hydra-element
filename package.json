{
  "name": "hydra-element",
  "version": "0.9.1",
  "description": "A custom element for embedding Hydra video synth scenes in HTML",
  "keywords": [
    "canvas",
    "creative-coding",
    "custom-element",
    "glsl",
    "hydra-synth",
    "livecoding",
    "synth",
    "video",
    "web-component"
  ],
  "homepage": "https://github.com/jdomizz/hydra-element#readme",
  "bugs": {
    "url": "https://github.com/jdomizz/hydra-element/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "jdomizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdomizz/hydra-element.git"
  },
  "sponsor": {
    "url": "https://opencollective.com/hydra-synth"
  },
  "qna": "https://github.com/jdomizz/hydra-element/discussions",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/hydra-element.js"
  ],
  "main": "dist/hydra-element.js",
  "module": "dist/hydra-element.js",
  "types": "dist/hydra-element.d.ts",
  "exports": {
    ".": {
      "types": "./dist/hydra-element.d.ts",
      "import": "./dist/hydra-element.js",
      "default": "./dist/hydra-element.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "build": "vite build --mode hydra-element && tsc -p tsconfig.types.json",
    "prepublishOnly": "pnpm check",
    "lint": "oxlint --fix .; oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm clean && pnpm build && pnpm publint && pnpm attw"
  },
  "dependencies": {
    "hydra-context": "^0.2.3",
    "hydra-synth": "^1.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "happy-dom": "^21.0.4",
    "oxc-standard": "^1.4.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.4.2"
}
