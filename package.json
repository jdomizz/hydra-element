{
  "name": "hydra-element",
  "version": "0.7.1",
  "description": "A custom element for embedding Hydra video synth scenes in HTML",
  "keywords": [
    "canvas",
    "creative-coding",
    "custom-element",
    "glsl",
    "hydra-synth",
    "livecoding",
    "synth",
    "video",
    "web-component"
  ],
  "homepage": "https://github.com/jdomizz/hydra-element#readme",
  "bugs": {
    "url": "https://github.com/jdomizz/hydra-element/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "jdomizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdomizz/hydra-element.git"
  },
  "sponsor": {
    "url": "https://opencollective.com/hydra-synth"
  },
  "qna": "https://github.com/jdomizz/hydra-element/discussions",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/hydra-element.js"
  ],
  "main": "dist/hydra-element.js",
  "module": "dist/hydra-element.js",
  "exports": {
    ".": "./dist/hydra-element.js",
    "./context": "./dist/context.js"
  },
  "scripts": {
    "dev": "vite --host",
    "test": "vitest run",
    "build": "vite build --mode hydra-element && vite build --mode context",
    "prepublishOnly": "pnpm build",
    "lint": "oxlint --fix .; oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "hydra-synth": "^1.4.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "oxc-standard": "^1.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.85.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
