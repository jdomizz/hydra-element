{
  "name": "hydra-element",
  "version": "0.7.0",
  "description": "A custom element for embedding Hydra video synth scenes in HTML",
  "keywords": [
    "canvas",
    "creative-coding",
    "custom-element",
    "glsl",
    "hydra-synth",
    "livecoding",
    "synth",
    "video",
    "web-component"
  ],
  "homepage": "https://jdomizz.github.io/hydra-element/playground/gallery.html",
  "bugs": {
    "url": "https://github.com/jdomizz/hydra-element/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "jdomizz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdomizz/hydra-element.git"
  },
  "packageManager": "pnpm@11.9.0",
  "sponsor": {
    "url": "https://opencollective.com/hydra-synth"
  },
  "qna": "https://github.com/jdomizz/hydra-element/discussions",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/hydra-element.js"
  ],
  "main": "dist/hydra-element.js",
  "module": "dist/hydra-element.js",
  "types": "dist/hydra-element.d.ts",
  "exports": {
    ".": {
      "types": "./dist/hydra-element.d.ts",
      "import": "./dist/hydra-element.js"
    },
    "./eval": {
      "types": "./dist/eval.d.ts",
      "import": "./dist/eval.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.js --host",
    "dev:playground": "vite --config vite.playground.config.js --host",
    "test": "wtr --config wtr.config.js",
    "build": "vite build",
    "postbuild": "test -f dist/hydra-element.d.ts && test -f dist/eval.d.ts",
    "build:playground": "vite build --config vite.playground.config.js",
    "preview:playground": "vite preview --config vite.playground.config.js",
    "lint": "oxlint --fix .",
    "check": "pnpm lint && pnpm test && pnpm build",
    "format": "oxfmt .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.md": "oxfmt"
  },
  "dependencies": {
    "hydra-synth": "^1.4.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@remcovaes/web-test-runner-vite-plugin": "^1.4.0",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxc-standard": "^1.4.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.80.0",
    "sinon": "^21.0.1",
    "vite": "^7.3.1"
  }
}
